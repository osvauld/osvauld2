# no leading slash: matches per-crate target/ dirs too, not just the workspace root
target/

# Engine app local data snapshots (dev-grade persistence; real store is the encrypted vault)
*.lua.snapshot

# Local machine / editor state
.claude/settings.local.json
# Agent scratch worktrees. Each is a full checkout on a throwaway branch; committing the gitlink
# leaves a dangling submodule-shaped entry once the worktree is pruned.
.claude/worktrees/
.DS_Store
